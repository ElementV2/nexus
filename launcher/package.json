{
  "name": "nexus-launcher",
  "version": "0.1.20",
  "private": true,
  "description": "Local launcher that runs the Nexus Next.js server on the LAN.",
  "author": "ElementV2 <death0factory@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/ElementV2/nexus.git"
  },
  "main": "build/main.js",
  "scripts": {
    "compile": "tsc && node ../scripts/copy-renderer.mjs",
    "dev": "npm run compile && electron .",
    "typecheck": "tsc --noEmit",
    "build:web": "cd .. && npm run build",
    "package:win": "node ./scripts/clean-public-downloads.mjs && npm run build:web && npm run compile && electron-builder --win --x64 --publish never",
    "release:win": "npm run package:win && node ./scripts/install-binary.mjs"
  },
  "build": {
    "appId": "com.nexus.launcher",
    "productName": "Nexus",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../.next/standalone",
        "to": "next-server"
      },
      {
        "from": "../.next/static",
        "to": "next-server/.next/static"
      },
      {
        "from": "../public",
        "to": "next-server/public"
      },
      {
        "from": "resources/icon.ico",
        "to": "icon.ico"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg*"
    ],
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Nexus-Setup-${version}.exe",
      "shortcutName": "Nexus"
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.0"
  }
}
